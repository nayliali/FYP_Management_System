                    "name": "Aida Zulaikha"
                  },
                  "changedOn": "2026-05-16T17:26:34.211Z"
                }
              ]
            },
            {
              "id": "117",
              "guid": "4e736a4e-9786-468e-a372-e7a993d107a6",
              "heading": "Scope",
              "text": "<p>FYP Management System covers online submission, supervisor assignment, milestone tracking, feedback and grading.</p>",
              "type": "SEC",
              "history": [
                {
                  "attributesChanged": {
                    "text": null
                  },
                  "changedBy": {
                    "company": "",
                    "email": "aidazulaikha3405@gmail.com",
                    "name": "Aida Zulaikha"
                  },
                  "changedOn": "2026-05-16T17:29:01.029Z"
                }
              ]
            },
            {
              "id": "118",
              "guid": "a1403b0b-8568-49a4-a6e1-0726d1b3c168",
