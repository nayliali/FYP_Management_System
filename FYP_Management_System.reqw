      "data": [
        {
          "id": "115",
          "guid": "db7f8e9a-1ba6-48a9-9eda-b1dea4fc35ca",
          "heading": "Introduction",
          "text": "<p>FYP Management System is a web-based platform design to improve the management and coordination of undergraduate final year projects.</p>",
          "type": "SEC",
          "history": [
            {
              "attributesChanged": {
                "text": null
              },
              "changedBy": {
                "company": "IIUM",
                "email": "naylimohdali@gmail.com",
                "name": "Nayli"
              },
              "changedOn": "2026-05-15T14:23:09.810Z"
            }
          ],
          "children": [
            {
              "id": "116",
              "guid": "ead2f789-8cab-470d-b118-e77ec5c69514",
              "heading": "Purpose",
              "text": "<p>Aim to centralize all FYP-related activities into a single platform, improving the efficiency.</p>",
              "type": "SEC",
              "history": [
                {
                  "attributesChanged": {
                    "text": null
                  },
                  "changedBy": {
                    "company": "IIUM",
                    "email": "naylimohdali@gmail.com",
                    "name": "Nayli"
                  },
                  "changedOn": "2026-05-15T14:24:01.428Z"
                },
                {
                  "attributesChanged": {
                    "text": "<p>Aim to centralize all FYP-related activities into a single platform</p>"
                  },
                  "changedBy": {
                    "company": "",
                    "email": "aidazulaikha3405@gmail.com",
                    "name": "Aida Zulaikha"
                  },
                  "changedOn": "2026-05-16T17:26:05.348Z"
                },
                {
                  "attributesChanged": {
                    "text": "<p>Aim to centralize all FYP-related activities into a single platform, improve the efficiency.</p>"
                  },
                  "changedBy": {
