            {
              "id": "128",
              "guid": "b58637e7-6df5-471b-928a-3d911784bf69",
              "heading": "Product functions",
              "type": "SEC"
            },
            {
              "id": "129",
              "guid": "ad23a3a5-e22f-4dad-8fe7-43a03e24d813",
              "heading": "User  characteristics",
              "type": "SEC"
            },
            {
