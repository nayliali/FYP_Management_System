                    }
                  ]
                }
              ]
            },
            {
              "id": "109",
              "guid": "a4f1c954-7d89-4eb6-9d6e-6f8e946238b2",
              "heading": "Constraints Requirements",
              "type": "SEC",
              "children": [
                {
                  "id": "137",
                  "guid": "c6962472-4b87-4020-bd7f-118feb8275d9",
                  "heading": "FYP-C-01",
                  "text": "<p>The system must be developed within 14 weeks or one semester and delivered by week 14</p>",
                  "source": "FYP Project Schedule (Document) and Project Supervisor (Stakeholder)",
                  "history": [
                    {
                      "affectedNodeId": "109",
                      "changedBy": {
                        "company": "IIUM",
                        "email": "naylimohdali@gmail.com",
                        "name": "Nayli"
                      },
                      "changedOn": "2026-05-15T16:00:30.902Z",
                      "docId": "SRS",
                      "structureAction": "Create"
                    },
                    {
                      "attributesChanged": {
                        "heading": null,
                        "text": null
                      },
                      "changedBy": {
                        "company": "IIUM",
                        "email": "naylimohdali@gmail.com",
                        "name": "Nayli"
                      },
                      "changedOn": "2026-05-15T16:00:30.902Z"
                    },
                    {
                      "attributesChanged": {
                        "source": null
                      },
