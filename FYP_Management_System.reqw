{
  "id": "FYP_Management_System",
  "description": "This project is to improve the management and coordination of undergraduate FYP",
  "documents": [
    {
      "id": "SRS",
      "guid": "c96cf226-be1c-4769-880c-e2a6c0ddda1a",
      "name": "Software Requirements Specification",
